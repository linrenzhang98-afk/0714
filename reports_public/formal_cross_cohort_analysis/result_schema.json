{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linrenzhang98-afk/0714/schemas/formal-cross-cohort-result-1.0.0.json",
  "title": "Cohort-specific formal shotgun ecology result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_status",
    "cohort",
    "n",
    "group_counts",
    "feature_filter",
    "zero_handling",
    "beta_diversity",
    "secondary_endpoints",
    "secondary_contrasts",
    "sample_metrics",
    "interpretation_boundary",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_status": {"enum": ["SYNTHETIC", "BIOLOGICAL"]},
    "cohort": {"type": "string", "minLength": 1},
    "n": {"type": "integer", "minimum": 4},
    "group_counts": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "integer", "minimum": 2}
    },
    "feature_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "input_features", "retained_features", "retained_feature_ids"],
      "properties": {
        "threshold": {"enum": [0.05, 0.1, 0.2]},
        "input_features": {"type": "integer", "minimum": 1},
        "retained_features": {"type": "integer", "minimum": 1},
        "retained_feature_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "zero_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {"method": {"type": "string", "minLength": 1}}
    },
    "beta_diversity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distance", "permanova", "permdisp"],
      "properties": {
        "distance": {"const": "Aitchison"},
        "permanova": {"$ref": "#/$defs/permutation_test"},
        "permdisp": {"$ref": "#/$defs/permutation_test"}
      }
    },
    "secondary_endpoints": {
      "type": "object",
      "required": ["richness", "shannon", "gini_simpson", "dominance", "classified_fraction"],
      "additionalProperties": false,
      "properties": {
        "richness": {"$ref": "#/$defs/secondary_test"},
        "shannon": {"$ref": "#/$defs/secondary_test"},
        "gini_simpson": {"$ref": "#/$defs/secondary_test"},
        "dominance": {"$ref": "#/$defs/secondary_test"},
        "classified_fraction": {"$ref": "#/$defs/secondary_test"}
      }
    },
    "secondary_contrasts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint", "contrast", "test", "p_value", "p_adjusted_holm", "rank_biserial"],
        "properties": {
          "endpoint": {"type": "string"},
          "contrast": {"type": "string"},
          "test": {"const": "Mann-Whitney"},
          "p_value": {"type": "number", "minimum": 0, "maximum": 1},
          "p_adjusted_holm": {"type": "number", "minimum": 0, "maximum": 1},
          "rank_biserial": {"type": "number", "minimum": -1, "maximum": 1}
        },
        "additionalProperties": {"type": ["number", "integer", "string"]}
      }
    },
    "sample_metrics": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "group", "richness", "shannon", "gini_simpson", "dominance", "classified_fraction"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "group": {"type": "string", "minLength": 1},
          "richness": {"type": "integer", "minimum": 1},
          "shannon": {"type": "number", "minimum": 0},
          "gini_simpson": {"type": "number", "minimum": 0, "maximum": 1},
          "dominance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "classified_fraction": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "interpretation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classified_fraction_is_bacterial_biomass", "direct_species_is_classifier_defined_subcomposition"],
      "properties": {
        "classified_fraction_is_bacterial_biomass": {"const": false},
        "direct_species_is_classifier_defined_subcomposition": {"const": true}
      }
    },
    "provenance": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "permutation_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statistic", "effect_size", "p_value", "permutations", "seed", "df_between", "df_within", "group_counts"],
      "properties": {
        "statistic": {"type": "number", "minimum": 0},
        "effect_size": {"type": "number", "minimum": 0, "maximum": 1},
        "p_value": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "permutations": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "df_between": {"type": "integer", "minimum": 1},
        "df_within": {"type": "integer", "minimum": 1},
        "group_counts": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "integer", "minimum": 2}}
      }
    },
    "secondary_test": {
      "type": "object",
      "required": ["test"],
      "properties": {"test": {"enum": ["Kruskal-Wallis", "Mann-Whitney"]}},
      "additionalProperties": {"type": ["number", "integer", "string"]}
    }
  }
}
